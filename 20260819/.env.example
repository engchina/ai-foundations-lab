# PDF レイアウト比較ラボの設定例

# Gradio / FastAPI
PDF_LAYOUT_LAB_HOST=127.0.0.1
PDF_LAYOUT_LAB_PORT=7860
PDF_LAYOUT_LAB_OUTPUT_DIR=.runs
PDF_LAYOUT_LAB_RENDER_DPI=300
PDF_LAYOUT_LAB_MAX_DEFAULT_PAGES=1

# エンジン有効化。カンマ区切り、または all。
PDF_LAYOUT_LAB_ENABLED_ENGINES=oci,dots_mocr,dots_mocr_api,unstructured,docling,pp_doclayout_v3,mineru,mineru_api,pymupdf,yolov10

# dots.mocr ローカル Transformers 実行
DOTS_MOCR_BACKEND=transformers
DOTS_MOCR_MODEL=rednote-hilab/dots.mocr
DOTS_MOCR_DEVICE=auto
DOTS_MOCR_DEVICE_MAP=
DOTS_MOCR_TORCH_DTYPE=auto
DOTS_MOCR_ATTN_IMPLEMENTATION=auto
DOTS_MOCR_MAX_NEW_TOKENS=24000

# dots.mocr (API) エンジンが使う OpenAI 互換サーバー（vLLM の `vllm serve rednote-hilab/dots.mocr` など）。
# モデル名は DOTS_MOCR_MODEL と共通。dots.mocr 本体も API で動かすなら DOTS_MOCR_BACKEND=api にする。
DOTS_MOCR_BASE_URL=http://127.0.0.1:8000/v1
DOTS_MOCR_API_KEY=
DOTS_MOCR_TIMEOUT_SECONDS=120

# OCI Document Understanding
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
OCI_DOCUMENT_LANGUAGE=auto

# Unstructured (Tesseract) の OCR 言語。先頭が主モデルになるので、中国語資料が多いなら chi_sim を先頭に
UNSTRUCTURED_OCR_LANGUAGES=jpn,eng,chi_sim

# Docling CPU 実行
DOCLING_DEVICE=cpu
DOCLING_NUM_THREADS=4
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true

# ローカルモデル / CLI
YOLOV10_MODEL_PATH=models/yolov10x_best.pt
PP_DOCLAYOUT_MODEL=PP-DocLayoutV3
PP_DOCLAYOUT_DEVICE=auto
PP_DOCLAYOUT_ENGINE=onnxruntime
PP_DOCLAYOUT_MODEL_SOURCE=BOS
MINERU_OUTPUT_DIR=
MINERU_COMMAND=auto
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_EXTRA_ARGS=
# mineru-api サーバー (mineru-api --host 0.0.0.0 --port 8000) の URL。MinerU (API) エンジンが使う
MINERU_API_URL=http://127.0.0.1:8887
